{
  "version": "v6.5.4",
  "base_compatibility": ["v6.5.3", "v6.5.3.1"],
  "release_name": "Incremental KB Lifecycle + Semantic Scope + Source Stability",
  "generation_model": "qwen2.5:7b",
  "embedding_model": "qwen3-embedding:8b",
  "reranker_model": "BAAI/bge-reranker-v2-m3",
  "chunk_size": 900,
  "chunk_overlap": 150,
  "minimum_retrieval_score": 0.55,
  "retrieval_top_k": {"vector": 10, "bm25": 10, "final": 3},
  "multi_query_alternative_count": 2,
  "incremental_kb_lifecycle": {
    "unchanged": "skip_existing_vectors",
    "new": "parse_chunk_embed_add_only",
    "modified": "remove_old_then_parse_chunk_embed_replace_only",
    "deleted": "remove_old_vectors_and_manifest_only",
    "full_rebuild_reserved_for": [
      "index_schema_or_embedding_identity_change",
      "missing_or_empty_tracked_qdrant",
      "existing_qdrant_without_usable_manifest"
    ]
  },
  "transactional_incremental_staging_copy": true,
  "source_snapshot_for_changed_files": true,
  "precommit_source_stability_guard": true,
  "full_rebuild_source_stability_guard": true,
  "semantic_rule_index_profile_scoped_signature": true,
  "semantic_rule_index_legacy_metadata_only_migration": true,
  "non_misra_kb_change_does_not_reembed_misra_profiles": true,
  "kb_update_worker_only_lock_owner": true,
  "kb_update_streamlit_double_click_guard": true,
  "single_query_semantic_bge_early_accept_preserved": true,
  "semantic_latency_decision_diagnostics_preserved": true,
  "retrieval_llm_diagnostics_separated": true,
  "patch_time_kb_rebuild": false,
  "models_changed": false,
  "production_qdrant_or_bm25_rebuild_performed_by_installer": false
}
