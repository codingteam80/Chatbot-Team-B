{
  "version": "v6.5.5.1",
  "release_name": "KB Update Notification UX Hotfix",
  "generation_model": "qwen2.5:7b",
  "embedding_model": "qwen3-embedding:8b",
  "reranker_model": "BAAI/bge-reranker-v2-m3",
  "vector_backend": "qdrant",
  "lexical_backend": "bm25",
  "retrieval_fusion": "rrf_then_bge",
  "chunk_size": 900,
  "chunk_overlap": 150,
  "minimum_retrieval_score": 0.55,
  "top_k": {
    "vector": 10,
    "bm25": 10,
    "final": 3
  },
  "multi_query": {
    "original_retained": true,
    "alternative_count": 2,
    "structured_json": true,
    "temperature": 0,
    "single_query_semantic_bge_early_accept": true,
    "ambiguous_path_uses_multi_query": true
  },
  "kb_update": {
    "unchanged": "skip_existing_vectors",
