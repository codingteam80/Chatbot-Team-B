    "modified": "remove_old_then_parse_chunk_embed_replace_only",
    "deleted": "remove_old_vectors_and_manifest_only",
    "transactional_staging": true,
    "source_snapshot": true,
    "source_stability_guard": true,
    "worker_only_cross_process_lock": true,
    "streamlit_confirmation_incremental_and_full_rebuild": true,
    "streamlit_long_worker_deferred_until_chat_layout_rendered": true,
    "incremental_core_changed": false
  },
  "ui": {
    "kb_maintenance_region_stable_during_update": true,
    "welcome_chat_region_stable_during_update": true,
    "confirmation_checkbox_incremental": true,
    "confirmation_checkbox_full_rebuild": true,
    "reserved_status_row_prevents_layout_jump": true,
    "kb_update_success_notification": "concise_counts_only",
    "kb_update_success_notification_text": "Knowledge Base is successfully updated. Added/Updated/Deleted counts only; technical details remain in logs.",
    "kb_update_success_notification_hides_technical_details": true
  },
  "diagnostics": {
    "retrieval_only": "scripts/test_retrieval_pipeline.py",
    "llm_from_verified_context": "scripts/test_llm_from_verified_context.py",
    "live_incremental_lifecycle": "scripts/test_incremental_kb_lifecycle_live.py",
    "completion_suite": "scripts/run_v6_5_5_completion_suite.py",
    "benchmark_bank": "qa/v6_5_5_completion_benchmark_bank.json",
    "benchmark_seed": 6501,
    "normal_question_target_seconds": 25,
    "v6_5_5_completion_suite_preserved": true
  },
  "cleanup": {
    "historical_test_evidence_preserved": true,
    "old_root_release_markers_archived": true,
    "old_root_component_manifests_archived": true,
    "obsolete_root_test_bats_archived": true,
    "superseded_validator_scripts_archived": true,
    "obsolete_rebuild_index_entrypoint_archived": true,
    "active_docs_reference_current_qwen_qdrant_stack": true,
    "storage_data_not_deleted_by_installer": true
  },
  "install_time_production_kb_rebuild": false,
  "base_release": "v6.5.5",
  "hotfix_scope": [
    "app.py success notification only",
    "manifest/validation evidence"
  ]
